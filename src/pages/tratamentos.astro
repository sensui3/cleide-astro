---
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import { createItemListSchema } from '../utils/schemas';

const structuredData = createItemListSchema([
  {
    name: "Psicanálise Clínica",
    url: "https://cleidesarkis.com.br/psicanalise/",
    description: "Investigação profunda do inconsciente para compreender padrões repetitivos e conflitos internos."
  },
  {
    name: "Terapia para Ansiedade",
    url: "https://cleidesarkis.com.br/terapia-ansiedade/",
    description: "Tratamento especializado integrando escuta psicanalítica e alívio do estresse crônico."
  },
  {
    name: "Terapia para Síndrome de Burnout",
    url: "https://cleidesarkis.com.br/terapia-burnout/",
    description: "Acolhimento psicanalítico para esgotamento profissional e sobrecarga no ambiente de trabalho."
  },
  {
    name: "Terapia para Síndrome do Pânico",
    url: "https://cleidesarkis.com.br/terapia-panico/",
    description: "Manejo de crises agudas e reestruturação da segurança emocional."
  },
  {
    name: "Terapia para Depressão",
    url: "https://cleidesarkis.com.br/terapia-depressao/",
    description: "Escuta analítica para elaboração do desânimo persistente, angústia e reencontro de sentido."
  },
  {
    name: "Terapia para Traumas e Medos",
    url: "https://cleidesarkis.com.br/terapia-traumas/",
    description: "Abordagem com regressão terapêutica e psicologia integrada para elaborar eventos difíceis do passado."
  },
  {
    name: "Terapia de Relacionamento",
    url: "https://cleidesarkis.com.br/terapia-relacionamento/",
    description: "Compreensão de padrões de repetição e melhoria da comunicação e conexão interpessoal."
  }
]);

const faqs = [
  {
    question: "Como funciona a psicanálise em São Paulo?",
    answer: "A psicanálise investiga o inconsciente para compreender e tratar conflitos internos, ansiedade, depressão e padrões repetitivos através da escuta qualificada."
  },
  {
    question: "Qual a diferença entre psicanálise e psicoterapia?",
    answer: "A psicanálise é uma abordagem mais profunda que busca as raízes dos conflitos no inconsciente, enquanto a psicoterapia foca em estratégias e comportamentos."
  },
  {
    question: "Preciso tomar remédio para ansiedade?",
    answer: "Não necessariamente. A psicanálise e a hipnose clínica oferecem tratamento não medicamentoso eficaz para ansiedade e outras condições."
  }
];
---

<BaseLayout 
  title="Tratamentos | Psicanálise, Hipnose e Regressão"
  description="Conheça todos os tratamentos realizados pela Dra. Cleide Sarkis: Psicanálise, Regressão, Hipnose Clínica e Psicoterapia Transpessoal."
  structuredData={structuredData}
>
  
  <section class="pt-40 pb-20 bg-brand-50">
    <div class="container text-center">
      <h1 class="text-3xl md:text-[34px] font-bold text-brand-700 mb-6 leading-tight">Nossos Tratamentos</h1>
      <p class="text-main text-slate-600 max-w-3xl mx-auto">Abordagens terapêuticas integradas para o tratamento de ansiedade, depressão, traumas e conflitos relacionais.</p>
    </div>
  </section>

  <Services />

  <section class="section-padding container">
    <div class="max-w-4xl mx-auto">
      <h2 class="heading-2 mb-12 text-center text-brand-600">Qual abordagem combina com você?</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {[
          {
            title: 'Ansiedade & Estresse',
            text: 'Hipnose e psicanálise para tratar a origem do nervosismo.',
            link: '/terapia-ansiedade/'
          },
          {
            title: 'Burnout & Esgotamento',
            text: 'Acolhimento psicanalítico para sobrecarga profissional e estresse corporativo.',
            link: '/terapia-burnout/'
          },
          {
            title: 'Síndrome do Pânico',
            text: 'Técnicas integradas para controle imediato de crises e tratamento da angústia.',
            link: '/terapia-panico/'
          },
          {
            title: 'Depressão & Desânimo',
            text: 'Escuta psicanalítica para reencontrar sentido e motivação.',
            link: '/terapia-depressao/'
          },
          {
            title: 'Traumas & Medos',
            text: 'Regressão e terapia transpessoal para elaborar eventos difíceis do passado.',
            link: '/terapia-traumas/'
          },
          {
            title: 'Relacionamentos',
            text: 'Entenda seus padrões de escolha e melhore sua forma de se conectar com os outros.',
            link: '/terapia-relacionamento/'
          }
        ].map(item => (
          <div class="p-8 border border-slate-100 rounded-3xl hover:bg-white hover:shadow-xl transition-all">
            <h3 class="heading-3 mb-4">{item.title}</h3>
            <p class="text-base-site text-slate-600 mb-6">{item.text}</p>
            <a href={item.link} class="text-brand-500 font-bold hover:gap-3 flex items-center gap-2 transition-all">
              Ver detalhes
              <span class="i-lucide-arrow-right"></span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding container reveal">
    <div class="max-w-4xl mx-auto bg-brand-600 rounded-[3rem] p-12 text-center text-white shadow-2xl">
      <h2 class="heading-2 text-white mb-6">Ficou com dúvidas sobre qual abordagem escolher?</h2>
      <p class="text-brand-100 mb-10 max-w-xl mx-auto">
        A definição da abordagem é feita na primeira conversa, considerando suas queixas principais e objetivos clínicos.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="/primeira-sessao/" class="btn-ghost !border-white !text-white hover:!bg-white/10 no-underline">
          Como funciona a sessão?
        </a>
        <a href="/contato/" class="btn-primary !bg-white !text-brand-700 hover:!bg-brand-50 no-underline">
          Agendar primeiro contato
        </a>
      </div>
    </div>
  </section>

  <Contact />
</BaseLayout>
