---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Contact from '../components/Contact.astro';
import { clinicSchema } from '../utils/schemas';
---
<BaseLayout 
  title="Psicanalista em São Paulo | Ansiedade e Depressão" 
  description="Especialista em psicanálise em São Paulo. Dra. Cleide Sarkis atende na Av. Paulista. Tratamento humanizado para ansiedade, depressão e autoconhecimento. Agende sua consulta."
  structuredData={clinicSchema}
>
  <Hero />
  <Problem />
  <About />
  <Testimonials />
  <Process />
  <Services />
  <FAQ />
  <Contact />
  <BlogPreview />

</BaseLayout>
