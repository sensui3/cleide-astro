---
import { Image } from 'astro:assets';
import { getWhatsappUrl } from '../utils/whatsapp';
import drImage from '../assets/cleide-sarkis.webp';

const { pathname } = Astro.url;
const whatsappUrl = getWhatsappUrl(pathname);
---

<section class="relative min-h-[75vh] flex items-center pt-28 pb-20 overflow-hidden bg-gradient-to-b from-brand-50/40 via-white to-white reveal">
  <!-- Glow decorativo de fundo suave -->
  <div class="absolute top-1/4 right-10 w-96 h-96 bg-brand-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-5 w-72 h-72 bg-amber-50/50 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="container relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Coluna de Texto & Ação -->
      <div class="lg:col-span-7 max-w-2xl">
        <!-- Eyebrow Badge de Contexto -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-brand-50 border border-brand-100/80 text-brand-700 text-xs font-semibold tracking-wide mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Psicanálise Clínica • Presencial (Paulista) & Online</span>
        </div>
        
        <!-- H1 -->
        <h1 class="heading-1 mb-6 text-brand-700">
          Você não precisa carregar <span class="italic font-300 text-brand-500">esse peso</span> sozinha
        </h1>
        
        <!-- Subtítulo com contraste e legibilidade adequados -->
        <p class="font-body text-slate-700 text-lg md:text-xl leading-relaxed mb-8 max-w-xl">
          Há mais de 35 anos ofereço um espaço acolhedor e sigiloso de escuta para você compreender as raízes de suas angústias, ansiedades e conflitos.
        </p>
        
        <!-- Bloco de Ações (CTAs) -->
        <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center mb-10">
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-[#25D366] text-white px-7 py-4 rounded-full font-bold flex items-center justify-center gap-3.5 hover:bg-[#1fb858] transition-all shadow-lg shadow-green-600/20 hover:shadow-xl hover:-translate-y-0.5 text-base no-underline group"
          >
            <span class="i-mdi-whatsapp text-2xl group-hover:scale-110 transition-transform"></span>
            <span>Quero dar o primeiro passo</span>
          </a>
          
          <a 
            href="/primeira-sessao/" 
            class="border-2 border-slate-200 text-slate-700 px-7 py-3.5 rounded-full font-bold flex items-center justify-center gap-2 hover:border-brand-500 hover:text-brand-500 hover:bg-brand-50/30 transition-all text-sm tracking-wider uppercase no-underline"
          >
            Como funciona?
          </a>
        </div>
        
        <!-- Pilares de Confiança Rápidos -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-100">
          <div class="flex items-center gap-2.5">
            <span class="i-lucide-shield-check text-brand-500 text-lg shrink-0"></span>
            <span class="text-xs font-semibold text-slate-600">Sigilo Ético Absoluto</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="i-lucide-map-pin text-brand-500 text-lg shrink-0"></span>
            <span class="text-xs font-semibold text-slate-600">Bela Vista (SP) & Online</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="i-lucide-clock text-brand-500 text-lg shrink-0"></span>
            <span class="text-xs font-semibold text-slate-600">35+ Anos de Prática</span>
          </div>
        </div>
      </div>
      
      <!-- Coluna da Foto & Autoridade -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Moldura elegante e contemporânea (sem barra azul pesada) -->
          <div class="relative aspect-[4/5] rounded-[2.5rem] overflow-hidden bg-slate-100 shadow-2xl ring-1 ring-slate-900/5">
            <Image 
              src={drImage} 
              alt="Dra. Cleide Sarkis - Psicanalista Clínica" 
              class="w-full h-full object-cover object-center" 
              widths={[400, 600, 800, drImage.width]} 
              sizes={`(max-width: 1024px) 100vw, 45vw`} 
              loading="eager" 
              fetchpriority="high" 
            />
          </div>
          
          <!-- Badge Flutuante Glassmorphism -->
          <div class="absolute -bottom-6 left-6 right-6 sm:right-auto bg-white/95 backdrop-blur-md p-5 rounded-2xl shadow-xl border border-slate-100/90 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center shrink-0">
              <span class="i-lucide-award text-2xl text-brand-600"></span>
            </div>
            <div>
              <p class="text-xs font-black tracking-wider uppercase text-brand-700">Dra. Cleide Sarkis</p>
              <p class="text-xs text-slate-600 font-medium">Psicanálise Clínica & Abordagem Humanizada</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
