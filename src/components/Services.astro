---
const services = [
  {
    title: 'Psicanálise Clínica',
    description: 'Vá além do alívio imediato dos sintomas. Pela fala livre, examinamos os padrões inconscientes que travam sua vida. O trabalho analítico vai para a origem do sofrimento, não só para os sintomas.',
    icon: 'i-lucide-brain-circuit'
  },
  {
    title: 'Psicologia Transpessoal',
    description: 'Uma visão integral do ser humano. Unimos a psicologia científica à dimensão transcendental da existência e trabalhamos questões de sentido e propósito próprios.',
    icon: 'i-lucide-sparkles'
  },
  {
    title: 'Terapia de Regressão',
    description: 'Ferramenta para trabalhar bloqueios que parecem inexplicáveis. Acessamos, com segurança e no ritmo do paciente, memórias guardadas que ainda geram sofrimento hoje.',
    icon: 'i-lucide-history'
  },
  {
    title: 'Hipnose Clínica',
    description: 'Acelere o processo de mudança comportamental. Com foco e relaxamento profundo, a hipnose atua em fobias, hábitos e controle da ansiedade.',
    icon: 'i-lucide-eye'
  }
];
---

<section id="tratamentos" class="section-padding bg-slate-50/30 reveal">
  <div class="container">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-4 lg:sticky lg:top-40">
        <span class="text-label mb-8 block">
          ESPECIALIDADES
        </span>
        <h2 class="heading-2 mb-8">
          Metodologia Integrada & <span class="italic font-300 text-brand-500">Abordagens</span>
        </h2>
        <p class="text-main mb-10 leading-relaxed">
          Unimos a investigação psicanalítica à hipnose clínica e à psicologia transpessoal. Cada plano terapêutico parte da sua demanda e se organiza em etapas.
        </p>
        <p class="text-slate-500 text-base mb-10 italic leading-relaxed">
          A indicação das abordagens varia conforme a queixa e a evolução do tratamento.
        </p>
        <a href="/tratamentos/" class="text-xs font-bold tracking-[0.2em] text-brand-500 hover:text-brand-600 transition-colors uppercase border-b-2 border-brand-500/20 pb-1">
          Explorar especialidades
        </a>
      </div>

      <div class="lg:col-span-8 grid sm:grid-cols-2 gap-8">
        {services.map(service => (
          <div class="p-12 bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group ring-1 ring-slate-50">
            <div class="w-14 h-14 bg-brand-50 text-brand-500 rounded-full flex items-center justify-center mb-10 group-hover:bg-brand-500 group-hover:text-white transition-all">
              <span class={service.icon + " text-2xl"}></span>
            </div>
            <h3 class="heading-3 mb-6">{service.title}</h3>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-body">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
